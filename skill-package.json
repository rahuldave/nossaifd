{
  "schema": "https://rahuldave.github.io/agent_skill_package_maker/schema/skill-package.v1.json",
  "version": 1,
  "repository": {
    "owner": "rahuldave",
    "name": "nossaifd",
    "url": "https://github.com/rahuldave/nossaifd"
  },
  "skills": [
    {
      "name": "nossaifd",
      "path": ".agents/skills/nossaifd"
    },
    {
      "name": "declaude",
      "path": ".agents/skills/declaude"
    }
  ],
  "install_extras": {
    "files": [
      ".agents/just/roles/nossaifd.just"
    ],
    "parts": {
      "AGENTS.md": ".agents/skills/nossaifd/assets/agents-prose.md",
      ".claude/settings.json": ".agents/skills/nossaifd/assets/claude-settings-hook.json",
      ".codex/hooks.json": ".agents/skills/nossaifd/assets/codex-hooks.json"
    },
    "seed": {
      ".github/workflows/nossaifd-prose.yml": ".agents/skills/nossaifd/assets/prose-check.yml"
    },
    "starter": {
      ".github/workflows/nossaifd-prose.yml": ".agents/skills/nossaifd/assets/prose-check.yml"
    }
  },
  "executables": {
    "required": [
      {
        "name": "uv",
        "check": "uv --version",
        "description": "Runs the checker with Python 3.11 or later: uv run --no-project python check.py page.md."
      }
    ],
    "optional": []
  },
  "npx": {
    "supported": true,
    "install": "npx skills add rahuldave/nossaifd -a codex --skill '*' -y"
  }
}
